# URL del backend agentboard-api (solo se usa server-side, en los Route Handlers proxy)
AGENTBOARD_API_URL=http://localhost:8080

# Debe coincidir con JWT_REFRESH_TTL_DAYS configurado en agentboard-api
REFRESH_TOKEN_TTL_DAYS=14

# "true" solo cuando la UI se sirva por HTTPS real (el navegador descarta las cookies
# de sesión si van con Secure sobre una conexión HTTP plana)
COOKIE_SECURE=false
